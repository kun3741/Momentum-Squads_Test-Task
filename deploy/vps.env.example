# Copy to /etc/orbita-support.env on the VPS; replace the three placeholders.
# PostgreSQL peer authentication uses the dedicated orbita OS and DB role.
DATABASE_URL=postgresql+psycopg:///orbita_support?host=/var/run/postgresql
OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_SECRET
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
HELPDESK_ALLOWED_ORIGIN=http://127.0.0.1:18001
PUBLIC_BASE_URL=https://REPLACE_WITH_TUNNEL_DOMAIN
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_LLM_DELAY_MIN=5
MOCK_LLM_DELAY_MAX=30
WORKER_CONCURRENCY=16
DB_POOL_TIMEOUT=0.25
DB_CONNECT_TIMEOUT=1
