[Unit]
Description=Orbita Cloudflare Quick Tunnel
After=network-online.target orbita-api.service
Wants=network-online.target
Requires=orbita-api.service

[Service]
User=orbita
Group=orbita
WorkingDirectory=/srv/orbita-support
Environment=HOME=/var/lib/orbita-tunnel
StateDirectory=orbita-tunnel
ExecStart=/srv/orbita-support/.tools/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:18000
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
